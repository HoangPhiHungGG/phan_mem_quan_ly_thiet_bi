# ===== Backend (apps/api) =====
# Cổng chạy API
PORT=3001

# MongoDB connection string
# Local dev (replica set 1 node - hỗ trợ transaction):
MONGODB_URI=mongodb://127.0.0.1:27017/pmqltb?replicaSet=rs0&directConnection=true
# Hoặc MongoDB Atlas (chỉ dùng nếu cluster hỗ trợ transaction - M10+):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pmqltb?retryWrites=true&w=majority

# CORS - danh sách origin được phép (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:3000

# Phiên cookie (1-168 giờ). Cookie tự bật Secure khi NODE_ENV=production.
SESSION_TTL_HOURS=8

# Chỉ dùng một lần khi database chưa có tài khoản; không commit mật khẩu thật.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_EMPLOYEE_CODE=

# ===== Frontend (apps/web) =====
# URL API backend
NEXT_PUBLIC_API_URL=http://localhost:3001

# ===== MongoDB local (docker/mongodb.yml) =====
# Tên replica set
MONGO_REPLICA_SET_NAME=rs0
# Cổng bind (chỉ 127.0.0.1)
MONGO_PORT=27017
